# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` al repositorio.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=ecoumb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecoumb

# --- API ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Carpeta de fotos de residuos. En Docker es un volumen (/srv/uploads); local: ./uploads
# STORAGE_DIR=./uploads
# Clasificador: onnx = modelo real de ml/models/v1 (por defecto en Docker); simulated = sin modelo
# CLASSIFIER=onnx
# Versión del modelo dentro de ml/models/ (v1: 6 materiales; v2: 8 clases; v3: 8 clases, más preciso)
# MODEL_VERSION=v3

# Claves JWT RS256. En desarrollo pueden omitirse (se genera un par efímero al arrancar).
# En producción son OBLIGATORIAS. Generarlas con:  python backend/scripts/generate_jwt_keys.py
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Frontend (se incrusta en el build; es público) ---
VITE_API_URL=http://localhost:8000
